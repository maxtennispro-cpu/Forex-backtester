# Copy to .env.local for local dev, and set the same values in Vercel
# (Project -> Settings -> Environment Variables). None of these are
# NEXT_PUBLIC_*, so they stay server-side and never reach the browser.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# The single password that gates the dashboard.
APP_PASSWORD=pick-something-long
