# Copy to .env (in the project root) and fill in. Never commit the real .env.
# Practice-account token: OANDA dashboard -> Manage API Access
OANDA_API_KEY=your-practice-api-token
OANDA_ENVIRONMENT=practice

# Web app: session-cookie signing key. Any long random string; if unset, a
# random key is generated per process (sessions reset on restart).
APP_SECRET_KEY=
